# Environment variables for catalog manager
# Copy this file to .env and customize

# Authentication
CATALOG_USERNAME=admin
CATALOG_PASSWORD=change-this-password

# Flask secret key (generate a random string)
FLASK_SESSION_SECRET_KEY=change-this-to-a-random-secret-key

# Paths (configured via Docker volumes)
EMSBUS_CONFIG_PATH=/app/config/emsbus.conf
CATALOG_BASE_DIR=/app/catalogs
